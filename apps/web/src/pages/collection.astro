---
import StoreLayout from '@/components/StoreLayout.astro';
import ConceptCard from '@/components/ConceptCard.astro';
import { getSiteConfig } from '@/lib/site-config';
const config = await getSiteConfig();
const collection = config.catalog;
const intro = config.pages.collection;
---
<StoreLayout title={intro.title} description={intro.description} config={config} canonicalPath={config.routes.collection}>
  <div class="wrap page-head"><p class="eyebrow">{intro.eyebrow}</p><h1>{intro.title}</h1><div class="collection-intro"><p>{intro.description}</p><aside>Concept images show design direction. Materials, dimensions, pricing and production feasibility remain open until a maker confirms them.</aside></div></div>
  <section class="wrap section" style="padding-top:0">
    <div class="filters">
      <label>Collection<select id="interest"><option value="">All collections</option><option>Pins</option><option>Photocards</option><option>Conventions</option><option>Everyday</option></select></label>
      <label>Bag shape<select id="shape"><option value="">All shapes</option><option>Backpack</option><option>Crossbody</option><option>Tote</option></select></label>
      <label>Mood<select id="mood"><option value="">All moods</option><option>Playful</option><option>Soft</option><option>Minimal</option></select></label>
      <button id="clear" class="text-link" type="button">Clear filters</button><span id="count" class="small filter-count" aria-live="polite"></span>
    </div>
    <div class="three">{collection.map((item, index) => <ConceptCard item={item} priority={index < 3} />)}</div>
    <div class="empty" id="empty" hidden><h2>No concept matches all three choices.</h2><p>Clear one filter to open the collection again.</p></div>
  </section>
  <section class="section green-band"><div class="wrap planning-layout"><div><p class="eyebrow">Need a more specific direction?</p><h2>Start with the collection itself.</h2></div><div><p>Use the design brief to describe quantity, display type, color and occasion. The result gives you a clearer starting point than choosing a bag shape alone.</p><a class="button" href={config.routes.customize}>Build your design brief <span aria-hidden="true">&rarr;</span></a></div></div></section>
</StoreLayout>
<script>
  const interest = document.querySelector<HTMLSelectElement>('#interest')!;
  const shape = document.querySelector<HTMLSelectElement>('#shape')!;
  const mood = document.querySelector<HTMLSelectElement>('#mood')!;
  const params = new URLSearchParams(location.search);
  for (const [select, key] of [[interest, 'interest'], [shape, 'shape'], [mood, 'mood']] as const) {
    const value = params.get(key);
    if (value && Array.from(select.options).some((option) => option.value === value)) select.value = value;
  }
  function filter() {
    let count = 0;
    document.querySelectorAll<HTMLElement>('[data-item]').forEach((item) => {
      const matches = (!interest.value || item.dataset.interest?.split(',').includes(interest.value)) && (!shape.value || item.dataset.shape === shape.value) && (!mood.value || item.dataset.mood === mood.value);
      item.hidden = !matches;
      if (matches) count += 1;
    });
    document.querySelector('#count')!.textContent = `${count} design${count === 1 ? '' : 's'}`;
    document.querySelector<HTMLElement>('#empty')!.hidden = count > 0;
  }
  [interest, shape, mood].forEach((select) => select.addEventListener('change', filter));
  document.querySelector('#clear')!.addEventListener('click', () => { interest.value = ''; shape.value = ''; mood.value = ''; filter(); });
  filter();
</script>
