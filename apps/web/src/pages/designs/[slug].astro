---
import StoreLayout from '@/components/StoreLayout.astro';
import ConceptCard from '@/components/ConceptCard.astro';
import { getSiteConfig } from '@/lib/site-config';
const config = await getSiteConfig();
const collection = config.catalog;
const item = collection.find((candidate) => candidate.slug === Astro.params.slug);
if (!item) return Astro.redirect('/404', 302);
const related = collection.filter((candidate) => candidate.slug !== item.slug).slice(0, 2);
---
<StoreLayout title={`${item.name} Ita Bag Concept`} description={item.description} config={config}>
  <section class="wrap product-detail">
    <div class="product-gallery"><div class="thumbs"><button class="thumb active" data-position="center" aria-label="Show full bag"><img src={item.image} alt="" /></button><button class="thumb" data-position="top" aria-label="Show top detail"><img src={item.image} alt="" /></button><button class="thumb" data-position="bottom" aria-label="Show display detail"><img src={item.image} alt="" /></button></div><img id="main-product" class="main-product-image" src={item.image} alt={`${item.name} concept, ${item.color} ${item.type}`} width="1024" height="1024" /></div>
    <div class="product-summary"><a class="small" href={config.routes.collection}>Concept collection / {item.type}</a><h1>{item.name}</h1><p>{item.description}</p><div class="concept-notice"><strong>Design concept</strong><br />The image defines the visual direction. Final construction and specifications require maker confirmation.</div>
      <div class="choice-group"><span>Color direction</span><div class="choice-row"><button class="choice-chip active" type="button"><i class="swatch" style={`background:${item.swatch}`}></i> {item.color}</button><button class="choice-chip" type="button">Adapt this palette</button></div></div>
      <div class="choice-group"><span>Concept profile</span><div class="choice-row"><span class="choice-chip">{item.display}</span><span class="choice-chip">{item.window} window</span><span class="choice-chip">{item.collectionSize} collection</span><span class="choice-chip">{item.occasion}</span></div></div>
      <div class="product-actions"><a class="button" href={`${config.routes.customize}?design=${item.slug}`}>Use as my starting point <span aria-hidden="true">&rarr;</span></a><button class="save-button" type="button" data-save={item.slug} aria-label="Save this concept" aria-pressed="false">Save</button></div><p class="status" id="save-status" role="status"></p>
    </div>
  </section>

  <section class="detail-band green-band"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Why this direction works</p><h2>Designed around the display.</h2></div><p>The visual result comes first. These are the decisions that give the concept its character and help translate it into a useful brief.</p></div><div class="feature-stories">{item.highlights.map((highlight, index) => <article class="feature-story"><p class="eyebrow">0{index + 1}</p><h3>{highlight.title}</h3><p>{highlight.text}</p></article>)}</div></div></section>

  <section class="detail-band"><div class="wrap planning-layout"><div><p class="eyebrow">Before production</p><h2>Four points to confirm.</h2><p class="lede">A concept becomes useful when the display, carry and construction requirements are explicit.</p></div><ol class="planning-list">{item.planningPoints.map((point) => <li>{point}</li>)}</ol></div></section>

  <section class="detail-band blue-band"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Continue exploring</p><h2>Another way to carry it.</h2></div><a class="text-link" href={config.routes.collection}>View the full collection <span aria-hidden="true">&rarr;</span></a></div><div class="three">{related.map((candidate) => <ConceptCard item={candidate} />)}<article class="signal"><p class="eyebrow">Build from your own idea</p><h3>Already know what you want?</h3><p>Turn the collection type, occasion and color direction into a downloadable design brief.</p><a class="button" href={config.routes.customize}>Start from scratch</a></article></div></div></section>
</StoreLayout>
<script>
  const mainImage = document.querySelector<HTMLImageElement>('#main-product')!;
  document.querySelectorAll<HTMLButtonElement>('.thumb').forEach((button) => button.addEventListener('click', () => {
    document.querySelectorAll('.thumb').forEach((thumb) => thumb.classList.remove('active'));
    button.classList.add('active');
    mainImage.style.objectPosition = button.dataset.position === 'top' ? 'center 20%' : button.dataset.position === 'bottom' ? 'center 80%' : 'center';
  }));
  const save = document.querySelector<HTMLButtonElement>('[data-save]')!;
  const key = 'ita-favorites';
  let state: { saved: string[]; votes: string[] } = { saved: [], votes: [] };
  try { const parsed = JSON.parse(localStorage.getItem(key) || '{}'); state = { saved: parsed.saved || [], votes: parsed.votes || [] }; } catch {}
  function render() { const active = state.saved.includes(save.dataset.save!); save.setAttribute('aria-pressed', String(active)); save.textContent = active ? 'Saved' : 'Save'; }
  save.addEventListener('click', () => { const id = save.dataset.save!; state.saved = state.saved.includes(id) ? state.saved.filter((value) => value !== id) : [...state.saved, id]; try { localStorage.setItem(key, JSON.stringify(state)); } catch {} document.querySelector('#save-status')!.textContent = state.saved.includes(id) ? 'Saved on this device.' : 'Removed from saved designs.'; render(); });
  render();
</script>
