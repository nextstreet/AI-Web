---
import StoreLayout from '@/components/StoreLayout.astro';
import { getPublishedContents } from '@/lib/data';
import { getSiteConfig } from '@/lib/site-config';
const pages = await getPublishedContents();
const config = await getSiteConfig();
const intro = config.pages.guides;
const featured = pages.find((page) => page.slug === 'ita-bag-insert-guide') || pages[0];
const topicName = (type: string) => type === 'product' ? 'Bags' : type === 'design_inspiration' ? 'Design' : type === 'material_guide' ? 'Materials' : type === 'comparison' ? 'Compare' : 'Use';
const topics = ['All','Bags','Design','Materials','Use','Compare'];
---
<StoreLayout title={intro.title} description={intro.description} config={config} canonicalPath={config.routes.guides}>
  <div class="wrap page-head"><p class="eyebrow">{intro.eyebrow}</p><h1>{intro.title}</h1><p>{intro.description}</p></div>
  <section class="wrap section" style="padding-top:0">
    <div class="topic-strip" role="tablist" aria-label="Filter guides by topic">{topics.map((topic, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} class={index === 0 ? 'active' : ''} data-topic={topic}>{topic}</button>)}</div>
    <a class="guide-feature" href={`/content/${featured.slug}`}><img src="/images/campaign.webp" alt="Pink and mint ita bag concept collection" /><div><p class="eyebrow">Featured field note</p><h2>{featured.title}</h2><p>{featured.metaDescription}</p><span class="text-link">Read the guide <span aria-hidden="true">&rarr;</span></span></div></a>
    <div class="section-head"><div><p class="eyebrow">Browse the library</p><h2>Choose the question you need.</h2></div><span id="guide-count" class="small"></span></div>
    <div class="guide-list">{pages.map((page) => <a class="guide-link" href={`/content/${page.slug}`} data-guide-topic={topicName(page.pageType)}><p class="eyebrow">{topicName(page.pageType)}</p><h3>{page.title} <span aria-hidden="true">&rarr;</span></h3><p>{page.metaDescription}</p></a>)}</div><div id="guide-empty" class="empty" hidden><h2>No notes in this topic yet.</h2></div>
  </section>
</StoreLayout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-topic]');
  function showTopic(topic: string) { let count = 0; document.querySelectorAll<HTMLElement>('[data-guide-topic]').forEach((guide) => { guide.hidden = topic !== 'All' && guide.dataset.guideTopic !== topic; if (!guide.hidden) count += 1; }); buttons.forEach((button) => { const selected = button.dataset.topic === topic; button.classList.toggle('active', selected); button.setAttribute('aria-selected', String(selected)); }); document.querySelector('#guide-count')!.textContent = `${count} field note${count === 1 ? '' : 's'}`; document.querySelector<HTMLElement>('#guide-empty')!.hidden = count > 0; }
  buttons.forEach((button) => button.addEventListener('click', () => showTopic(button.dataset.topic!))); showTopic('All');
</script>
