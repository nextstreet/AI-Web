---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCmsProductCategories, getCmsProducts, isCmsEnabled, type CmsProduct } from '../../lib/cms/payload';

const products = await getCmsProducts();
const categories = await getCmsProductCategories();

function formatPrice(product: CmsProduct) {
  if (product.priceFrom == null) return 'Price on request';
  return `From ${product.priceCurrency ?? 'USD'} ${product.priceFrom.toFixed(2)}`;
}
---

<BaseLayout
  title="Products"
  description="Reviewed product formats, display components, and custom production options."
  canonicalPath="/products/"
  noIndex={!isCmsEnabled()}
>
  <p class="eyebrow">Product catalog</p>
  <h1>Products built around the collection.</h1>
  <p class="lede">Review published product formats and components before preparing a custom project brief.</p>

  {products.length > 0 ? (
    <div class="grid">
      {categories.map((category) => {
        const categoryProducts = products.filter((product) => product.categorySlug === category.slug);
        return categoryProducts.length > 0 && (
          <section class="card" aria-labelledby={`category-${category.slug}`}>
            <h2 id={`category-${category.slug}`}>{category.name}</h2>
            {category.description && <p>{category.description}</p>}
            <ul>
              {categoryProducts.map((product) => (
                <li>
                  <a href={`/products/${product.slug}/`}><strong>{product.name}</strong></a>
                  <p>{product.description}</p>
                  <p class="price">{formatPrice(product)}</p>
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  ) : (
    <p class="meta">The reviewed product catalog is not configured yet.</p>
  )}
</BaseLayout>

<style>
  .price { font-weight: 600; color: #6d2e68; }
  li { margin-block: 1rem; }
</style>
