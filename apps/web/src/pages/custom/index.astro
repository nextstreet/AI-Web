---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlockRenderer from '../../components/cms/BlockRenderer.astro';
import {
  getPublishedCmsPage,
  getPublishedCmsPages,
  getCmsProducts,
  getCmsProductCategories,
  isCmsEnabled,
  type CmsProduct,
} from '../../lib/cms/directus';

const cmsPages = (await getPublishedCmsPages()).filter((page) => page.pageType === 'customization' && page.path !== '/custom/');
const cmsPaths = new Set(cmsPages.map((page) => page.path));
const pages = isCmsEnabled()
  ? []
  : (await getCollection('pages', ({ data }) => data.reviewed && data.pageType === 'customization'))
      .filter(({ data }) => !cmsPaths.has(data.canonicalPath));
const cmsPage = await getPublishedCmsPage('/custom/');
const cmsProducts = await getCmsProducts();
const cmsCategories = await getCmsProductCategories();

function formatPrice(product: CmsProduct) {
  if (product.priceFrom == null) return 'Price on request';
  const currency = product.priceCurrency ?? 'USD';
  return `From ${currency} ${Number(product.priceFrom).toFixed(2)}`;
}
---

<BaseLayout title={cmsPage?.seoTitle ?? cmsPage?.title ?? 'Custom Ita Bag Planning'} description={cmsPage?.description ?? 'Reviewed resources for planning a custom Ita Bag project, from display architecture to sampling and production review.'} canonicalPath="/custom/" noIndex={cmsPage?.noIndex}>
  <p class="eyebrow">{cmsPage?.eyebrow ?? 'Customization'}</p>
  <h1>{cmsPage?.title ?? 'Plan the bag around the collection.'}</h1>
  <p class="lede">{cmsPage?.lead ?? 'Turn display needs, bag format, materials, and production constraints into a decision-ready brief.'}</p>
  {cmsPage && (cmsPage.blocks.length > 0
    ? <BlockRenderer blocks={cmsPage.blocks} />
    : cmsPage.bodyHtml && <article class="prose cms-body" set:html={cmsPage.bodyHtml} />)}

  {cmsProducts.length > 0 && (
    <section aria-labelledby="product-heading">
      <h2 id="product-heading">Product catalog</h2>
      <div class="grid">
        {cmsCategories.map((category) => (
          <article class="card">
            <h3>{category.name}</h3>
            {category.description && <p>{category.description}</p>}
            <ul>
              {cmsProducts.filter((p) => p.categorySlug === category.slug).map((product) => (
                <li>
                  <a href={`/products/${product.slug}/`}>
                  <strong>{product.name}</strong>
                  </a>
                  <p>{product.description}</p>
                  <p class="price">{formatPrice(product)}</p>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="grid">
    {pages.map(({ data }) => <a class="card card-link" href={data.canonicalPath}><h2>{data.title}</h2><p>{data.description}</p></a>)}
    {cmsPages.map((page) => <a class="card card-link" href={page.path}><h2>{page.title}</h2><p>{page.description}</p></a>)}
  </section>
</BaseLayout>

<style>
  .price { font-weight: 600; color: #6d2e68; }
</style>
