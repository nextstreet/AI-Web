---
import type { CmsProductPresentationBlock } from '../../lib/cms/payload';

interface Props {
  blocks: CmsProductPresentationBlock[];
}

const { blocks } = Astro.props;
---

{blocks.map((block) => (
  block.blockType === 'richText' ? (
    <article class="prose cms-body" set:html={block.html} />
  ) : block.blockType === 'imageText' ? (
    <section class:list={['image-text', block.imagePosition]}>
      {block.image && <img src={block.image} alt={block.heading ?? ''} loading="lazy" />}
      <div>
        {block.heading && <h2>{block.heading}</h2>}
        {block.body && <p>{block.body}</p>}
      </div>
    </section>
  ) : block.blockType === 'specTable' ? (
    <section>
      {block.title && <h2>{block.title}</h2>}
      <table>
        <tbody>
          {block.rows.map((row) => (
            <tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>
          ))}
        </tbody>
      </table>
    </section>
  ) : block.blockType === 'sizeGuide' ? (
    <section>
      {block.title && <h2>{block.title}</h2>}
      {block.image && <img class="guide-image" src={block.image} alt={block.title ?? 'Size guide'} loading="lazy" />}
      {block.notes && <p>{block.notes}</p>}
    </section>
  ) : block.blockType === 'comparison' ? (
    <section>
      {block.title && <h2>{block.title}</h2>}
      <div class="grid">
        {block.items.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            {item.text && <p>{item.text}</p>}
          </article>
        ))}
      </div>
    </section>
  ) : block.blockType === 'faq' ? (
    <section class="faq" aria-label={block.title ?? 'Frequently asked questions'}>
      {block.title && <h2>{block.title}</h2>}
      {block.items.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>
  ) : (
    <aside class="cta-card">
      {block.heading && <h2>{block.heading}</h2>}
      {block.body && <p>{block.body}</p>}
      {block.buttonLabel && block.buttonHref && (
        <a class="cta-button" href={block.buttonHref}>{block.buttonLabel}</a>
      )}
    </aside>
  )
))}

<style>
  .image-text {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    margin-block: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .image-text.right > img { order: 2; }
  .image-text img, .guide-image { max-width: 100%; border-radius: 1rem; }
  .image-text h2 { margin-top: 0; }
  table { width: 100%; border-collapse: collapse; margin-block: 1rem; }
  th, td { padding: .65rem; border: 1px solid #eadde8; text-align: left; }
  .faq details {
    border: 1px solid #eadde8;
    border-radius: 1rem;
    padding: 1rem 1.25rem;
    margin-block: .75rem;
    background: white;
  }
  .faq summary { font-weight: 600; cursor: pointer; }
  .cta-card {
    margin-top: 2.5rem;
    padding: 1.6rem;
    border: 1px solid #d9b8d2;
    border-radius: 1rem;
    background: white;
  }
  .cta-card h2 { margin-top: 0; }
  .cta-button {
    display: inline-block;
    margin-top: .75rem;
    padding: .7rem 1.4rem;
    border-radius: 999px;
    background: #6d2e68;
    color: white;
    font-weight: 700;
    text-decoration: none;
  }
</style>
