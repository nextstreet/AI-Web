---
import type { CollectionItem } from '@/lib/collection';
interface Props { item: CollectionItem; priority?: boolean }
const { item, priority = false } = Astro.props;
---
<article class="concept-card" data-item data-interest={`${item.display},${item.occasion}`} data-shape={item.type} data-mood={item.mood}>
  <a class="design-image" href={`/designs/${item.slug}`}>
    <img src={item.image} alt={`${item.name}, ${item.color} ${item.type} concept`} width="1024" height="1024" loading={priority ? 'eager' : 'lazy'} />
    <span class="tag">CONCEPT / {item.type.toUpperCase()}</span>
    <span class="image-action" aria-hidden="true">View</span>
  </a>
  <div class="card-line"><h3><a href={`/designs/${item.slug}`}>{item.name}</a></h3><span class="swatch" style={`background:${item.swatch}`}></span></div>
  <p class="small">{item.type} &middot; {item.display} &middot; {item.window} window</p>
  <p class="card-description">{item.description}</p>
  <a class="text-link" href={`/designs/${item.slug}`}>Discover the design <span aria-hidden="true">&rarr;</span></a>
</article>
