---
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  schema?: Record<string, unknown>;
}

const { title, description, canonicalPath, schema } = Astro.props;
const siteName = import.meta.env.PUBLIC_SITE_NAME ?? 'Ita Bag Design Lab';
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title} | {siteName}</title>
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="shell">
      <a class="brand" href="/">{siteName}</a>
      <nav aria-label="Main navigation">
        <a href="/custom/">Custom</a>
        <a href="/guides/">Guides</a>
        <a href="/studio/">V1 Studio</a>
      </nav>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer class="shell">V1 foundation — content requires review before publication.</footer>
  </body>
</html>

<style is:global>
  :root {
    color: #211a2b;
    background: #fffafc;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.6; }
  .shell { width: min(1120px, calc(100% - 2rem)); margin-inline: auto; }
  header { display: flex; justify-content: space-between; gap: 2rem; padding-block: 1.25rem; }
  nav { display: flex; flex-wrap: wrap; gap: 1rem; }
  a { color: #6d2e68; }
  .brand { color: inherit; font-weight: 800; text-decoration: none; }
  main { min-height: 72vh; padding-block: 4rem; }
  footer { border-top: 1px solid #eadde8; padding-block: 2rem; color: #6b6270; }
  h1 { max-width: 18ch; font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: 1; letter-spacing: -0.04em; }
  .eyebrow { color: #9a3d86; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; }
  .lede { max-width: 64ch; font-size: 1.2rem; color: #554b59; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 3rem; }
  .card { padding: 1.4rem; border: 1px solid #eadde8; border-radius: 1rem; background: white; }
  .card h2, .card h3 { margin-top: 0; }
  .card-link { display: block; color: inherit; text-decoration: none; }
  .card-link:hover { border-color: #b96aa8; transform: translateY(-2px); }
  .prose { max-width: 72ch; }
  .prose h2 { margin-top: 2.5rem; line-height: 1.2; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; list-style: none; font-size: .9rem; }
  .breadcrumbs li:not(:last-child)::after { content: '/'; margin-left: .5rem; color: #978c9b; }
  .meta { color: #6b6270; }
  .pill { display: inline-block; padding: .2rem .65rem; border-radius: 999px; background: #f3e4f0; font-size: .85rem; font-weight: 700; }
  .steps { padding-left: 1.25rem; }
  .steps li { margin-block: .75rem; }
  @media (max-width: 680px) {
    header { align-items: flex-start; flex-direction: column; gap: .75rem; }
    main { padding-block: 2.5rem; }
  }
</style>
