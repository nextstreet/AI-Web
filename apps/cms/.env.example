# Payload 加密密钥，务必替换为随机长字符串
PAYLOAD_SECRET=change-me-to-a-long-random-secret

# SQLite 数据库文件位置。验证阶段用文件，切 Postgres 时改这里即可
DATABASE_URI=file:./payload.db

# 后台对外访问地址（部署后填服务器地址）
NEXT_PUBLIC_CMS_URL=http://localhost:3000

# 发布后自动触发 GitHub Actions 重建静态站点。未配置时不会触发。
# DEPLOY_HOOK_URL=https://api.github.com/repos/<owner>/<repo>/dispatches
# DEPLOY_HOOK_TOKEN=github_pat_with_repo_scope

# AI 生成脚本可选：供应商密钥由具体脚本读取，不在这里配置
