{
  "name": "ai-seo-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ai-seo/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:push": "node scripts/db-push.mjs",
    "db:verify": "node scripts/verify-db.mjs",
    "health": "node scripts/health.mjs",
    "dev:cms": "pnpm --filter @ai-seo/cms dev",
    "cms:types": "pnpm --filter @ai-seo/cms generate:types",
    "cms:importmap": "pnpm --filter @ai-seo/cms generate:importmap",
    "cms:import": "node scripts/import-payload.mjs"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
