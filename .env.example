PUBLIC_SITE_NAME="Ita Bag Design Lab"
PUBLIC_SITE_URL="http://localhost:4321"

# Supabase Postgres connection string used by pnpm db:push / db:verify / doctor.
# Copy the value from Supabase -> Project Settings -> Database -> Connection string.
#SUPABASE_DB_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Optional build-time CMS (Payload). Leave PAYLOAD_URL unset to fall back to
# Markdown content in apps/web/src/content.
# PAYLOAD_URL="http://localhost:3000"
# PAYLOAD_LOCALE="en"
# PAYLOAD_TENANT_ID="ita-bag-lab"

# Used by pnpm cms:import to write into Payload (Markdown pages + products).
# PAYLOAD_ADMIN_EMAIL="admin@example.com"
# PAYLOAD_ADMIN_PASSWORD="change-me"
