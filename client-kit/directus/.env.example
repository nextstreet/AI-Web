# Directus instance secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY=replace-with-32-byte-hex-key
SECRET=replace-with-32-byte-hex-secret

# Initial administrator account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Public URL used for links and asset redirects
PUBLIC_URL=http://localhost:8055

# Local Postgres container credentials
DB_POSTGRES_USER=directus
DB_POSTGRES_PASSWORD=directus
DB_POSTGRES_DB=directus

# Token used only by directus/seed/seed.mjs to load deterministic development
# content. Create a static token for the admin user in Data Studio, then paste
# it here; never commit the real value.
DIRECTUS_ADMIN_TOKEN=
