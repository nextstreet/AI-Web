      "id": "b1a2c3d4-0005-4e5f-8a9b-0c1d2e3f4a05",
      "name": "Fetch approved deliverables",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
        -140
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "replace-with-directus-credential-id",
          "name": "Directus Automation Token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const config = $('Config').first().json;\nconst out = [];\nconst allowed = ['post', 'page', 'product'];\n\nfor (const item of $input.all()) {\n  for (const d of item.json.data ?? []) {\n    const tenant = d.tenant;\n    if (!tenant) continue;\n    if (tenant.enabled === false) continue;\n    if (!tenant.wp_base_url) continue;\n    if (!allowed.includes(d.target_post_type)) continue;\n\n    out.push({\n      json: {\n        ...d,\n        tenant,\n        tenantId: tenant.id,\n        tenantSlug: tenant.slug,\n        directusUrl: config.directusUrl,\n        writeSeoMeta: config.writeSeoMeta === true,\n        startedAt: new Date().toISOString(),\n      },\n    });\n  }\n}\n\nreturn out;",
        "options": {}
      },
      "id": "b1a2c3d4-0006-4e5f-8a9b-0c1d2e3f4a06",
      "name": "Prepare deliverables",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        -140
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "b1a2c3d4-0007-4e5f-8a9b-0c1d2e3f4a07",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        800,
        -140
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $json.directusUrl + '/items/deliverables/' + $json.id }}",
        "authentication": "genericCredentialType",
        "genericCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'pushing' }) }}",
        "options": {}
      },
      "id": "b1a2c3d4-0008-4e5f-8a9b-0c1d2e3f4a08",
      "name": "Claim deliverable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        -140
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "replace-with-directus-credential-id",
          "name": "Directus Automation Token"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const d = $('Loop Over Items').first().json;\nconst tenant = d.tenant;\nconst isProduct = d.target_post_type === 'product';\nconst wpBaseUrl = String(tenant.wp_base_url || '').replace(/\\/+$/, '');\nconst existingId = Number(d.wp_post_id || d.target_post_id || 0) || null;\n\nfunction escapeHtml(value) {\n  return String(value)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;');\n}\n\nfunction inline(value) {\n  return value\n    .replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1</strong>')\n    .replace(/(^|[^*])\\*([^*]+)\\*/g, '$1<em>$2</em>')\n    .replace(/\\[([^\\]]+)\\]\\((https?:\\/\\/[^\\s)]+)\\)/g, '<a href=\"$2\">$1</a>');\n}\n\nfunction markdownToHtml(markdown) {\n  const lines = String(markdown || '').replace(/\\r\\n/g, '\\n').split('\\n');\n  const out = [];\n  let paragraph = [];\n  let listType = null;\n  let items = [];\n\n  function flushParagraph() {\n    if (!paragraph.length) return;\n    out.push('<p>' + inline(escapeHtml(paragraph.join(' '))) + '</p>');\n    paragraph = [];\n  }\n\n  function flushList() {\n    if (!listType) return;\n    out.push('<' + listType + '>' + items.join('') + '</' + listType + '>');\n    items = [];\n    listType = null;\n  }\n\n  for (const rawLine of lines) {\n    const line = rawLine.trimEnd();\n    if (!line.trim()) {\n      flushParagraph();\n      flushList();\n      continue;\n    }\n    const heading = /^(#{1,6})\\s+(.*)$/.exec(line);\n    if (heading) {\n      flushParagraph();\n      flushList();\n      const level = heading[1].length;\n      out.push('<h' + level + '>' + inline(escapeHtml(heading[2])) + '</h' + level + '>');\n      continue;\n    }\n    const bullet = /^[-*+]\\s+(.*)$/.exec(line);\n    if (bullet) {\n      flushParagraph();\n      if (listType !== 'ul') {\n        flushList();\n        listType = 'ul';\n      }\n      items.push('<li>' + inline(escapeHtml(bullet[1])) + '</li>');\n      continue;\n    }\n    const ordered = /^\\d+\\.\\s+(.*)$/.exec(line);\n    if (ordered) {\n      flushParagraph();\n      if (listType !== 'ol') {\n        flushList();\n        listType = 'ol';\n      }\n      items.push('<li>' + inline(escapeHtml(ordered[1])) + '</li>');\n      continue;\n    }\n    flushList();\n    paragraph.push(line.trim());\n  }\n  flushParagraph();\n  flushList();\n  return out.join('\\n');\n}\n\nconst policy = tenant.publish_policy || 'draft_only';\nconst publishAt = d.publish_at ? new Date(d.publish_at) : null;\nconst isFuture = publishAt !== null && !Number.isNaN(publishAt.getTime()) && publishAt.getTime() > Date.now();\nlet status = 'draft';\nif (policy !== 'draft_only') {\n  if (isFuture) status = isProduct ? 'draft' : 'future';\n  else status = 'publish';\n}\n\nfunction numericIds(value) {\n  return (Array.isArray(value) ? value : [])\n    .map(function (term) { return Number(term); })\n    .filter(function (term) { return Number.isInteger(term) && term > 0; });\n}\n\nfunction termNames(value) {\n  return (Array.isArray(value) ? value : []).filter(function (term) {\n    return !/^\\d+$/.test(String(term));\n  });\n}\n\nconst categories = numericIds(d.target_categories);\nconst tags = numericIds(d.target_tags);\nconst skippedTerms = termNames(d.target_categories)\n  .map(function (name) { return 'category:' + name; })\n  .concat(termNames(d.target_tags).map(function (name) { return 'tag:' + name; }));\n\nconst seoPlugin = tenant.seo_plugin || 'none';\nlet meta = null;\nif (d.writeSeoMeta && seoPlugin !== 'none') {\n  const seoTitle = d.seo_title || d.title;\n  const seoDescription = d.seo_description || d.excerpt || '';\n  if (seoPlugin === 'yoast') {\n    meta = { _yoast_wpseo_title: seoTitle, _yoast_wpseo_metadesc: seoDescription };\n    if (d.canonical_url) meta._yoast_wpseo_canonical = d.canonical_url;\n  } else if (seoPlugin === 'rankmath') {\n    meta = { rank_math_title: seoTitle, rank_math_description: seoDescription };\n    if (d.canonical_url) meta.rank_math_canonical_url = d.canonical_url;\n  }\n}\n\nconst contentHtml = markdownToHtml(d.body_md);\nconst articlePath = d.target_post_type === 'page' ? 'pages' : 'posts';\nlet wpPayload;\nlet pushUrl;\n\nif (isProduct) {\n  const extra = d.payload && typeof d.payload === 'object' ? d.payload : {};\n  let attributes;\n  if (Array.isArray(extra.attributes)) {\n    attributes = extra.attributes;\n  } else if (extra.attributes && typeof extra.attributes === 'object') {\n    attributes = Object.keys(extra.attributes).map(function (name) {\n      const options = extra.attributes[name];\n      return {\n        name: name,\n        options: (Array.isArray(options) ? options : [options]).map(String),\n        visible: true,\n      };\n    });\n  }\n  wpPayload = {\n    name: d.title,\n    slug: d.slug || undefined,\n    type: extra.type || 'simple',\n    status: status,\n    description: contentHtml,\n    short_description: d.excerpt || '',\n    sku: extra.sku || undefined,\n    regular_price: extra.regular_price || extra.price || undefined,\n    stock_status: extra.stock_status || undefined,\n    images: d.featured_image_url ? [{ src: d.featured_image_url }] : undefined,\n    attributes: attributes,\n  };\n  pushUrl = wpBaseUrl + '/wp-json/wc/v3/products' + (existingId ? '/' + existingId : '');\n} else {\n  wpPayload = {\n    title: d.title,\n    slug: d.slug || undefined,\n    content: contentHtml,\n    excerpt: d.excerpt || '',\n    status: status,\n    categories: categories.length ? categories : undefined,\n    tags: tags.length ? tags : undefined,\n    date: status === 'future' && publishAt ? publishAt.toISOString() : undefined,\n    meta: meta || undefined,\n  };\n  pushUrl = wpBaseUrl + '/wp-json/wp/v2/' + articlePath + (existingId ? '/' + existingId : '');\n}\n\nlet mediaSearchTerm = '';\nif (d.featured_image_url) {\n  try {\n    const path = new URL(d.featured_image_url).pathname;\n    mediaSearchTerm = decodeURIComponent(path.split('/').pop() || '').replace(/\\.[a-z0-9]+$/i, '');\n  } catch (error) {\n    mediaSearchTerm = '';\n  }\n}\nmediaSearchTerm = mediaSearchTerm || d.slug || '';\n\nreturn [{\n  json: {\n    deliverableId: d.id,\n    tenantId: d.tenantId,\n    tenantSlug: d.tenantSlug,\n    seoPlugin: seoPlugin,\n    targetPostType: d.target_post_type,\n    isProduct: isProduct,\n    existingId: existingId,\n    action: existingId ? 'update' : 'create',\n    wpBaseUrl: wpBaseUrl,\n    pushUrl: pushUrl,\n    wpPayload: wpPayload,\n    featuredImageUrl: d.featured_image_url || '',\n    mediaSearchTerm: mediaSearchTerm,\n    skippedTerms: skippedTerms,\n    startedAt: d.startedAt,\n    directusUrl: d.directusUrl,\n  },\n}];",
        "options": {}
      },
      "id": "b1a2c3d4-0009-4e5f-8a9b-0c1d2e3f4a09",
