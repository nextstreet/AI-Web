    {
      "parameters": {
        "url": "={{ $json.directusUrl }}/items/deliverables",
        "authentication": "genericCredentialType",
        "genericCredentialType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filter[status][_eq]",
              "value": "approved"
            },
            {
              "name": "filter[target_post_type][_nnull]",
